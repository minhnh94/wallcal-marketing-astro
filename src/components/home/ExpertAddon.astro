---
import Screenshot from '../Screenshot.astro';
import { useLocalizePath, useTranslations } from '../../i18n';

const t = useTranslations(Astro.url).expert;
const l = useLocalizePath(Astro.url);
---

<section class="pt-24 md:pt-36">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="relative overflow-hidden rounded-[32px] bg-ink-950 text-white">
      <div class="absolute -right-40 -top-40 w-[560px] h-[560px] rounded-full wallpaper opacity-40 blur-[110px] pointer-events-none" aria-hidden="true"></div>

      <div class="relative grid lg:grid-cols-2 gap-10 p-8 md:p-14 items-center">
        <div data-aos="fade-up">
          <span class="inline-flex items-center gap-2 rounded-full bg-white/10 ring-1 ring-white/15 px-3 py-1 text-xs font-medium uppercase tracking-[0.14em] text-white/80">{t.badge}</span>
          <h2 class="mt-5 text-h2 font-semibold text-balance">
            {t.titleA}
            <span class="font-serif italic font-normal text-brand-300">{t.titleEm}</span>
          </h2>
          <p class="mt-5 text-lg text-white/65 max-w-md">
            {t.body}
          </p>

          <ul class="mt-8 grid sm:grid-cols-2 gap-x-6 gap-y-3">
            {t.perks.map((p) => (
              <li class="flex items-start gap-2.5 text-[15px] text-white/85">
                <svg class="mt-0.5 w-5 h-5 shrink-0 text-brand-300" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 10.5 3.2 3.2L15 7" /></svg>
                {p}
              </li>
            ))}
          </ul>

          <a
            class="btn mt-10 bg-white text-ink-950 hover:bg-white/90 hover:-translate-y-px"
            href={l('/expert-calendar-addon')}
            data-posthog-event="navigation_link_clicked"
            data-posthog-location="expert_addon_section"
            data-posthog-nav-label="Expert Calendar Addon"
          >
            {t.cta} <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="rounded-3xl overflow-hidden ring-1 ring-white/10" data-aos="fade-up" data-aos-delay="150">
          <Screenshot src="/my-assets/shots/weekly-wide.jpg" alt={t.alt} ratio="4 / 3" />
        </div>
      </div>
    </div>
  </div>
</section>
