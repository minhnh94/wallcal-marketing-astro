---
import Screenshot from '../Screenshot.astro';
import { useLocalizePath, useTranslations } from '../../i18n';

const t = useTranslations(Astro.url).features;
const l = useLocalizePath(Astro.url);

const appearances = [
  { id: 'glass', file: 'nativeGlass', ...t.appearance.glass },
  { id: 'transparent', file: 'transparent', ...t.appearance.transparent },
  { id: 'blurred', file: 'blurred', ...t.appearance.blurred },
];
---

<section id="features" class="pt-24 md:pt-36 scroll-mt-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-2xl" data-aos="fade-up">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="mt-4 text-h2 font-semibold text-balance">
        {t.titleA}
        <span class="text-ink-300">{t.titleB}</span>
      </h2>
    </div>

    <div class="mt-12 grid lg:grid-cols-3 gap-4">

      <!-- Month view -->
      <article class="card overflow-hidden lg:col-span-2 flex flex-col" data-aos="fade-up">
        <div class="p-7 md:p-9 pb-0 md:pb-0">
          <h3 class="text-2xl font-semibold tracking-tight">{t.month.title}</h3>
          <p class="mt-2 text-ink-500 max-w-md">{t.month.body}</p>
        </div>
        <div class="mt-7 mx-7 md:mx-9 rounded-t-2xl overflow-hidden grow">
          <Screenshot src="/my-assets/shots/month.jpg" alt={t.month.alt} ratio="3700 / 2320" />
        </div>
      </article>

      <!-- Sub calendar -->
      <article class="card overflow-hidden flex flex-col" data-aos="fade-up" data-aos-delay="100">
        <div class="p-7 pb-0">
          <h3 class="text-2xl font-semibold tracking-tight">{t.sidebar.title}</h3>
          <p class="mt-2 text-ink-500">{t.sidebar.body}</p>
        </div>
        <div class="mt-7 mx-7 rounded-t-2xl overflow-hidden grow">
          <Screenshot src="/my-assets/shots/sidebar.jpg" alt={t.sidebar.alt} ratio="2 / 3" />
        </div>
      </article>

      <!-- Weekly agenda -->
      <article class="card overflow-hidden flex flex-col" data-aos="fade-up">
        <div class="p-7 pb-0">
          <div class="flex items-center gap-2">
            <h3 class="text-2xl font-semibold tracking-tight">{t.weekly.title}</h3>
          </div>
          <p class="mt-2 text-ink-500">{t.weekly.body}</p>
          <a href={l('/expert-calendar-addon')} class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-brand-50 text-brand-600 px-2.5 py-1 text-xs font-medium hover:bg-brand-100 transition" data-posthog-event="navigation_link_clicked" data-posthog-location="features_weekly" data-posthog-nav-label="Expert Calendar Addon">
            {t.addonPill} <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div class="mt-7 mx-7 rounded-t-2xl overflow-hidden grow">
          <Screenshot src="/my-assets/shots/weekly.jpg" alt={t.weekly.alt} ratio="1840 / 2300" />
        </div>
      </article>

      <!-- Appearance switcher -->
      <article class="card overflow-hidden lg:col-span-2" data-aos="fade-up" data-aos-delay="100" x-data="{ mode: 'glass' }">
        <div class="grid md:grid-cols-[1fr_1.25fr] gap-6 p-7 md:p-9">
          <div class="flex flex-col">
            <h3 class="text-2xl font-semibold tracking-tight">{t.appearance.title}</h3>
            <p class="mt-2 text-ink-500">{t.appearance.body}</p>
            <div class="mt-6 flex flex-col gap-2" role="tablist" aria-label={t.appearance.label}>
              {appearances.map((a) => (
                <button
                  type="button"
                  role="tab"
                  class="text-left rounded-2xl px-4 py-3 ring-1 transition"
                  :class={`mode === '${a.id}' ? 'bg-ink-950 text-white ring-ink-950' : 'bg-white text-ink-700 ring-black/[0.07] hover:ring-black/20'`}
                  :aria-selected={`mode === '${a.id}'`}
                  @click={`mode = '${a.id}'`}
                  data-posthog-event="appearance_preview_clicked"
                  data-posthog-appearance={a.id}
                >
                  <span class="block text-[15px] font-medium">{a.name}</span>
                  <span class="block text-sm opacity-70">{a.note}</span>
                </button>
              ))}
            </div>
          </div>
          <div class="relative rounded-2xl overflow-hidden grid bg-ink-900">
            {appearances.map((a) => (
              <div class="[grid-area:1/1] rounded-2xl overflow-hidden" x-show={`mode === '${a.id}'`} x-transition.opacity.duration.300ms x-cloak={a.id !== 'glass' ? '' : undefined}>
                <Screenshot src={`/my-assets/shots/appearance-${a.file}.jpg`} alt={t.appearance.alt(a.name)} ratio="4 / 3" class="h-full object-cover" />
              </div>
            ))}
          </div>
        </div>
      </article>

      <!-- Hotkey -->
      <article class="card p-7 md:p-9 flex flex-col" data-aos="fade-up">
        <h3 class="text-2xl font-semibold tracking-tight">{t.hotkey.title}</h3>
        <p class="mt-2 text-ink-500">{t.hotkey.body}</p>
        <div class="mt-auto pt-8 flex items-center gap-2" aria-hidden="true">
          <span class="keycap">⌃</span>
          <span class="keycap">⌥</span>
          <span class="keycap min-w-16">{t.hotkey.space}</span>
        </div>
        <p class="mt-3 text-xs text-ink-500">{t.hotkey.note}</p>
      </article>

      <!-- Menu bar -->
      <article class="card p-7 md:p-9 flex flex-col" data-aos="fade-up" data-aos-delay="100">
        <h3 class="text-2xl font-semibold tracking-tight">{t.menubar.title}</h3>
        <p class="mt-2 text-ink-500">{t.menubar.body}</p>
        <div class="mt-auto pt-8" aria-hidden="true">
          <div class="rounded-2xl bg-paper ring-1 ring-black/[0.06] p-2 text-sm">
            <div class="flex items-center justify-end gap-3 px-2 pb-2 text-ink-500 text-xs">
              <span class="flex items-center justify-center w-6 h-5 rounded-md bg-ink-950 text-white">
                <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="12" height="11" rx="2"/><path d="M2 6.5h12M5.5 1.5v3M10.5 1.5v3"/></svg>
              </span>
              <span>{t.menubar.clock}</span>
            </div>
            <div class="rounded-xl bg-white ring-1 ring-black/[0.06] shadow-sm py-1.5">
              <div class="flex items-center justify-between px-3 py-1.5 text-ink-700">
                <span class="text-ink-500">&lsaquo;</span><span class="font-medium">{t.menubar.today}</span><span class="text-ink-500">&rsaquo;</span>
              </div>
              {t.menubar.items.map((item, i) => (
                <div class:list={['px-3 py-1.5 text-ink-700', i === 0 && 'mx-1.5 rounded-lg bg-brand-500 text-white']}>{item}</div>
              ))}
            </div>
          </div>
        </div>
      </article>

      <!-- Extras -->
      <article class="card p-7 md:p-9" data-aos="fade-up" data-aos-delay="200">
        <h3 class="text-2xl font-semibold tracking-tight">{t.extras.title}</h3>
        <ul class="mt-5 space-y-3">
          {t.extras.items.map((e) => (
            <li class="flex items-start gap-3 text-ink-700">
              <svg class="mt-0.5 w-5 h-5 shrink-0 text-brand-500" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 10.5 3.2 3.2L15 7" /></svg>
              <span>
                {e.text}
                {e.addon && <span class="ml-1 rounded-full bg-brand-50 text-brand-600 px-2 py-0.5 text-[11px] font-medium align-middle whitespace-nowrap">{t.extras.badge}</span>}
              </span>
            </li>
          ))}
        </ul>
      </article>

    </div>
  </div>
</section>
