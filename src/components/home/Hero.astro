---
import { useLinks } from '../../lib/links';
import { getLocale, useTranslations } from '../../i18n';

const links = useLinks(Astro.url);
const video = `/my-assets/video/promo-${getLocale(Astro.url)}`;

const t = useTranslations(Astro.url).hero;
---

<section class="relative isolate pt-32 md:pt-40">
  <!-- Ambient wallpaper glow -->
  <div class="absolute inset-x-0 top-0 h-[720px] -z-10 pointer-events-none" aria-hidden="true">
    <div class="absolute left-1/2 top-[-180px] -translate-x-1/2 w-[1100px] h-[620px] rounded-full wallpaper opacity-30 blur-[120px]"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-3xl mx-auto text-center">
      <div data-aos="fade-up">
        <span class="glass inline-flex items-center gap-2 rounded-full pl-1.5 pr-3.5 py-1.5 text-[13px] text-ink-700">
          <span class="rounded-full bg-ink-950 text-white px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider">{t.badge}</span>
          <span class="sm:hidden">{t.eyebrowShort}</span><span class="hidden sm:inline">{t.eyebrow}</span>
        </span>
      </div>

      <h1 class="mt-7 text-display font-semibold text-balance" data-aos="fade-up" data-aos-delay="80">
        {t.titleA}
        <span class="font-serif italic font-normal tracking-[-0.02em] text-brand-500 whitespace-nowrap">{t.titleEm}</span>
        {t.titleB}
      </h1>

      <p class="mt-6 text-lg md:text-xl text-ink-500 max-w-2xl mx-auto text-pretty" data-aos="fade-up" data-aos-delay="160">
        {t.lead}
      </p>

      <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-3" data-aos="fade-up" data-aos-delay="240">
        <a
          class="btn btn-primary w-full sm:w-auto"
          href={links.appStore}
          target="_blank"
          rel="nofollow noreferrer"
          data-posthog-event="download_cta_clicked"
          data-posthog-location="hero"
          data-posthog-provider="app_store"
          data-posthog-cta-text="App Store"
        >
          {t.ctaAppStore}
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          class="btn btn-glass w-full sm:w-auto"
          href={links.setapp}
          target="_blank"
          rel="nofollow noreferrer"
          data-posthog-event="download_cta_clicked"
          data-posthog-location="hero"
          data-posthog-provider="setapp"
          data-posthog-cta-text="Setapp"
        >
          {t.ctaSetapp}
        </a>
      </div>

      <!-- Store ratings: trust right next to the buttons -->
      <div class="mt-5 flex flex-wrap items-center justify-center gap-x-5 gap-y-1.5 text-sm text-ink-700" data-aos="fade-up" data-aos-delay="300">
        <span class="inline-flex items-center gap-2">
          <span class="flex gap-0.5" aria-hidden="true">
            {[0, 1, 2, 3, 4].map((i) => (
              <svg class:list={['size-4', i < 4 ? 'text-amber-500' : 'text-ink-300']} viewBox="0 0 20 20" fill="currentColor"><path d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" /></svg>
            ))}
          </span>
          <span class="text-balance">{t.ratingAppStore}</span>
        </span>
        <span class="inline-flex items-center gap-2">
          <svg class="size-4 text-brand-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M1 8.25a1.25 1.25 0 1 1 2.5 0v7.5a1.25 1.25 0 1 1-2.5 0v-7.5ZM11 3V1.7c0-.268.14-.526.395-.607A2 2 0 0 1 14 3c0 .995-.182 1.948-.514 2.826-.204.54.166 1.174.744 1.174h2.52c1.243 0 2.261 1.01 2.146 2.247a23.864 23.864 0 0 1-1.341 5.974C17.153 16.323 16.072 17 14.9 17h-3.192a3 3 0 0 1-1.341-.317l-2.734-1.366A3 3 0 0 0 6.292 15H5V8h.963c.685 0 1.258-.483 1.612-1.068a4.011 4.011 0 0 1 2.166-1.73c.432-.143.853-.386 1.011-.814.16-.432.248-.9.248-1.388Z" /></svg>
          <span class="text-balance">{t.ratingSetapp}</span>
        </span>
      </div>

      <p class="mt-3 text-sm text-ink-500" data-aos="fade-up" data-aos-delay="300">
        {t.micro}
      </p>
    </div>

    <!-- WallCal's video (the App Store preview, rendered in the WallCal repo), one per locale.
         It plays muted on a loop by itself; the button restarts it with sound. -->
    <div class="relative mt-16 md:mt-20" data-aos="fade-up" data-aos-delay="200">
      <div class="relative rounded-[22px] md:rounded-[32px] p-1.5 md:p-2 bg-white/60 ring-1 ring-black/[0.06] shadow-[0_40px_120px_-40px_rgba(60,30,90,0.45)]">
        <div class="group relative overflow-hidden rounded-[17px] md:rounded-[25px] aspect-video bg-ink-900">
          <video
            class="absolute inset-0 w-full h-full object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            poster={`${video}-poster.jpg`}
            aria-label={t.videoLabel}
            data-hero-video
          >
            <source src={`${video}.mp4`} type="video/mp4" />
          </video>
          <button
            type="button"
            class="absolute inset-0 flex items-end justify-end p-3 md:p-5 focus-visible:outline-none"
            data-hero-play
            data-posthog-event="hero_video_sound_clicked"
            data-posthog-location="hero"
          >
            <span class="inline-flex items-center gap-2 rounded-full bg-white/90 text-ink-950 pl-3 pr-4 py-2 text-sm font-medium shadow-xl ring-1 ring-black/5 backdrop-blur transition-transform group-hover:scale-105 group-focus-within:ring-4 group-focus-within:ring-white/60">
              <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11.05-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z" /></svg>
              {t.play}
            </span>
          </button>
        </div>
      </div>
    </div>
    <script is:inline>
      (() => {
        const video = document.querySelector('[data-hero-video]');
        const play = document.querySelector('[data-hero-play]');
        if (!video || !play) return;
        // Muted loop for everyone, Reduce Motion included. iOS can refuse it (Low Power Mode blocks autoplay),
        // so retry when the video comes into view, the tab comes back, or on the first touch.
        // Until the visitor asks for sound (loop goes false), then it's theirs to pause.
        const kick = () => { if (video.paused && video.loop) video.play().catch(() => {}); };
        kick();
        new IntersectionObserver((entries) => entries.some((e) => e.isIntersecting) && kick()).observe(video);
        document.addEventListener('visibilitychange', () => document.visibilityState === 'visible' && kick());
        document.addEventListener('touchend', kick, { passive: true });
        // The click restarts it from the top with sound.
        play.addEventListener('click', () => {
          play.remove();
          video.loop = false;
          video.muted = false;
          video.currentTime = 0;
          video.controls = true;
          video.play();
        });
      })();
    </script>
  </div>
</section>
