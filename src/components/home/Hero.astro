---
import { useLinks } from '../../lib/links';
import { useTranslations } from '../../i18n';

const links = useLinks(Astro.url);

const t = useTranslations(Astro.url).hero;
---

<section class="relative isolate pt-32 md:pt-40">
  <!-- Ambient wallpaper glow -->
  <div class="absolute inset-x-0 top-0 h-[720px] -z-10 pointer-events-none" aria-hidden="true">
    <div class="absolute left-1/2 top-[-180px] -translate-x-1/2 w-[1100px] h-[620px] rounded-full wallpaper opacity-30 blur-[120px]"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-3xl mx-auto text-center">
      <div data-aos="fade-up">
        <span class="glass inline-flex items-center gap-2 rounded-full pl-1.5 pr-3.5 py-1.5 text-[13px] text-ink-700">
          <span class="rounded-full bg-ink-950 text-white px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider">{t.badge}</span>
          <span class="sm:hidden">{t.eyebrowShort}</span><span class="hidden sm:inline">{t.eyebrow}</span>
        </span>
      </div>

      <h1 class="mt-7 text-display font-semibold text-balance" data-aos="fade-up" data-aos-delay="80">
        {t.titleA}
        <span class="font-serif italic font-normal tracking-[-0.02em] text-brand-500 whitespace-nowrap">{t.titleEm}</span>
        {t.titleB}
      </h1>

      <p class="mt-6 text-lg md:text-xl text-ink-500 max-w-2xl mx-auto text-pretty" data-aos="fade-up" data-aos-delay="160">
        {t.lead}
      </p>

      <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-3" data-aos="fade-up" data-aos-delay="240">
        <a
          class="btn btn-primary w-full sm:w-auto"
          href={links.appStore}
          target="_blank"
          rel="nofollow noreferrer"
          data-posthog-event="download_cta_clicked"
          data-posthog-location="hero"
          data-posthog-provider="app_store"
          data-posthog-cta-text="App Store"
        >
          {t.ctaAppStore}
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          class="btn btn-glass w-full sm:w-auto"
          href={links.setapp}
          target="_blank"
          rel="nofollow noreferrer"
          data-posthog-event="download_cta_clicked"
          data-posthog-location="hero"
          data-posthog-provider="setapp"
          data-posthog-cta-text="Setapp"
        >
          {t.ctaSetapp}
        </a>
      </div>

      <p class="mt-5 text-sm text-ink-500" data-aos="fade-up" data-aos-delay="300">
        {t.micro}
      </p>
    </div>

    <!-- Intro video: real captures of WallCal, under a minute -->
    <div class="relative mt-16 md:mt-20" data-aos="fade-up" data-aos-delay="200">
      <div class="relative rounded-[22px] md:rounded-[32px] p-1.5 md:p-2 bg-white/60 ring-1 ring-black/[0.06] shadow-[0_40px_120px_-40px_rgba(60,30,90,0.45)]">
        <div class="relative overflow-hidden rounded-[17px] md:rounded-[25px] aspect-video bg-ink-900">
          <video
            class="absolute inset-0 w-full h-full object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/my-assets/video/wallcal-intro-poster.jpg"
            aria-label={t.videoLabel}
            data-hero-video
          >
            <source src="/my-assets/video/wallcal-intro.webm" type="video/webm" />
            <source src="/my-assets/video/wallcal-intro.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </div>
    <script is:inline>
      (() => {
        // Respect reduced motion: show the poster with controls instead of autoplaying.
        const video = document.querySelector('[data-hero-video]');
        if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          video.removeAttribute('autoplay');
          video.pause();
          video.controls = true;
        }
      })();
    </script>
  </div>
</section>
