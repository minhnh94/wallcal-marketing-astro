---
// Stand-in for product screenshots while the app is unfinished.
// Pass `src` to swap in the real image without touching the surrounding layout.
interface Props {
  label: string;
  ratio?: string;
  src?: string;
  alt?: string;
  tone?: 'light' | 'glass';
  class?: string;
}

const { label, ratio = '16 / 10', src, alt = '', tone = 'light', class: className } = Astro.props;
---

{src ? (
  <img src={src} alt={alt || label} class:list={['w-full h-auto rounded-[inherit]', className]} style={`aspect-ratio: ${ratio}`} loading="lazy" />
) : (
  <div
    class:list={[
      'relative w-full overflow-hidden rounded-[inherit] grid place-items-center',
      tone === 'glass'
        ? 'bg-white/35 backdrop-blur-xl ring-1 ring-white/60'
        : 'bg-[repeating-linear-gradient(135deg,rgba(0,0,0,0.025)_0_12px,transparent_12px_24px)] bg-white/60 ring-1 ring-black/[0.06]',
      className,
    ]}
    style={`aspect-ratio: ${ratio}`}
    role="img"
    aria-label={`Screenshot placeholder: ${label}`}
    data-screenshot-placeholder={label}
  >
    <div class="flex flex-col items-center gap-2 px-4 text-center">
      <span class:list={['flex items-center justify-center w-10 h-10 rounded-2xl', tone === 'glass' ? 'bg-white/70 text-ink-700' : 'bg-white text-ink-500 ring-1 ring-black/5']}>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="16" rx="3" />
          <circle cx="9" cy="10" r="1.6" />
          <path d="m21 16-5-5-8 9" />
        </svg>
      </span>
      <span class:list={['text-xs font-medium uppercase tracking-[0.12em]', tone === 'glass' ? 'text-ink-900/80' : 'text-ink-500']}>Screenshot</span>
      <span class:list={['text-sm', tone === 'glass' ? 'text-ink-900' : 'text-ink-700']}>{label}</span>
    </div>
  </div>
)}
