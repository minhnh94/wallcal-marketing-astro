---
import { useLinks } from '../lib/links';
import { useTranslations } from '../i18n';

const links = useLinks(Astro.url);
const t = useTranslations(Astro.url);
---

<!-- Phones only: a download bar that appears once the hero buttons scroll away and leaves before the closing CTA.
     A phone can't install a Mac app, so where the share sheet exists the main action sends the App Store link to the visitor's Mac. -->
<div
  class="md:hidden fixed inset-x-0 bottom-0 z-30 px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] transition duration-300 translate-y-full opacity-0"
  data-mobile-cta
  inert
>
  <div class="glass flex gap-2 rounded-full p-1.5">
    <a
      class="btn btn-primary flex-1"
      href={links.appStore}
      target="_blank"
      rel="nofollow noreferrer"
      data-mobile-cta-store
      data-short-label={t.mobileCta.appStore}
      data-posthog-event="download_cta_clicked"
      data-posthog-location="mobile_sticky"
      data-posthog-provider="app_store"
      data-posthog-cta-text="App Store"
    >{t.hero.ctaAppStore}</a>
    <button
      type="button"
      class="btn btn-primary flex-1"
      data-send-to-mac
      data-posthog-event="send_to_mac_clicked"
      data-posthog-location="mobile_sticky"
      hidden
    >{t.mobileCta.send}</button>
  </div>
</div>

<script is:inline define:vars={{ shareUrl: links.appStore, shareText: t.mobileCta.shareText }}>
  (() => {
    const bar = document.querySelector('[data-mobile-cta]');
    const store = document.querySelector('[data-mobile-cta-store]');
    if (!bar || !store) return;

    // Send to my Mac: phones and tablets with a share sheet (AirDrop, Messages, Reminders…). Also wires the hero's link.
    if (navigator.share && matchMedia('(pointer: coarse)').matches) {
      for (const button of document.querySelectorAll('[data-send-to-mac]')) {
        button.hidden = false;
        button.addEventListener('click', () => {
          navigator.share({ title: 'WallCal', text: shareText, url: shareUrl }).catch(() => {});
        });
      }
      store.classList.replace('btn-primary', 'btn-glass');
      store.textContent = store.dataset.shortLabel;
    }

    const heroCtas = document.querySelector('[data-hero-ctas]');
    const end = document.querySelector('[data-bottom-cta]');
    if (!heroCtas || !end) return;
    let queued = false;
    const update = () => {
      queued = false;
      const show = heroCtas.getBoundingClientRect().bottom < 0 && end.getBoundingClientRect().top > innerHeight;
      bar.classList.toggle('translate-y-full', !show);
      bar.classList.toggle('opacity-0', !show);
      bar.inert = !show;
    };
    addEventListener('scroll', () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    addEventListener('resize', update);
    update();
  })();
</script>
