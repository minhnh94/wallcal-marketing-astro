---
// WallCal's status item open in the menu bar: the menu AppDelegate builds, in light mode, with the hotkey
// from the hotkey card recorded on its first item. The status icon is the app's StatusBarIcon.svg.
import Canvas from './Canvas.astro';
import { pt } from '../../lib/mock';
import type { Dict } from '../../i18n/en';

interface Props { t: Dict; class?: string }
const { t, class: className } = Astro.props;
const m = t.features.menubar.menu;
const items: { label: string; key?: string }[] = [
  { label: m.toggle, key: '⌃⌥Space' },
  { label: m.revert },
  { label: m.preferences, key: '⌘,' },
  { label: m.about },
  { label: m.faq },
  { label: m.support },
  { label: m.quit },
];
const W = 420, H = 216, bar = 24;
---
<Canvas stage={[W, H]} at={[2560 - W, 0]} class={className}>
  <!-- Menu bar, transparent on the wallpaper as in macOS Tahoe -->
  <div class="mk-abs" style={`left:0;top:0;width:${pt(W)};height:${pt(bar)};display:flex;align-items:center;justify-content:flex-end;gap:${pt(6)};padding-right:${pt(10)};font-size:${pt(13)};font-weight:500;text-shadow:0 0 ${pt(4)} rgb(0 0 0/0.25)`}>
    <span style={`display:grid;place-items:center;width:${pt(32)};height:${pt(22)};border-radius:${pt(6)};background:rgb(255 255 255/0.26)`}>
      <svg viewBox="0 0 18 18" style={`width:${pt(16)};height:${pt(16)}`}>
        <g fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round"><rect x="1.75" y="3.75" width="14.5" height="12.5" rx="2.75" stroke-width="1.5" /><path d="M6 2v3.5M12 2v3.5" stroke-width="1.5" /><path d="M2.5 7.5h13M6.75 8v7.5" stroke-width="1" /></g>
        <g fill="#fff"><rect x="3.75" y="9.5" width="1.5" height="4.75" rx=".75" /><rect x="9" y="9.5" width="1.75" height="1.75" rx=".5" /><rect x="12.25" y="9.5" width="1.75" height="1.75" rx=".5" /><rect x="9" y="12.75" width="1.75" height="1.75" rx=".5" /><rect x="12.25" y="12.75" width="1.75" height="1.75" rx=".5" /></g>
      </svg>
    </span>
    <!-- Wi-Fi and Control Center -->
    <span style={`display:grid;place-items:center;width:${pt(28)}`}>
      <svg viewBox="0 0 18 14" style={`width:${pt(17)};height:${pt(13)}`} fill="#fff"><path d="M9 2.2c2.6 0 5 1 6.8 2.7l1-1A11 11 0 0 0 9 .8 11 11 0 0 0 1.2 3.9l1 1A9.6 9.6 0 0 1 9 2.2Zm0 3.5c1.6 0 3.1.6 4.3 1.7l1-1A7.6 7.6 0 0 0 9 4.3c-2 0-3.9.8-5.3 2.1l1 1A6.2 6.2 0 0 1 9 5.7Zm0 3.5c.7 0 1.3.3 1.8.7L9 11.7 7.2 9.9c.5-.4 1.1-.7 1.8-.7Z" /></svg>
    </span>
    <span style={`display:grid;place-items:center;width:${pt(28)}`}>
      <svg viewBox="0 0 16 14" style={`width:${pt(15)};height:${pt(13)}`} fill="none" stroke="#fff" stroke-width="1.3"><rect x="1" y="1" width="14" height="5" rx="2.5" /><rect x="1" y="8" width="14" height="5" rx="2.5" /><circle cx="12.5" cy="3.5" r="1.4" fill="#fff" stroke="none" /><circle cx="3.5" cy="10.5" r="1.4" fill="#fff" stroke="none" /></svg>
    </span>
    <span style={`padding-left:${pt(4)};white-space:nowrap`}>{t.features.menubar.clock}</span>
  </div>

  <!-- The menu, under the bar and kept on screen -->
  <div
    class="mk-abs"
    style={`right:${pt(8)};top:${pt(bar + 3)};min-width:${pt(240)};padding:${pt(5)};border-radius:${pt(12)};background:rgb(246 246 248/0.84);backdrop-filter:blur(${pt(30)}) saturate(1.8);-webkit-backdrop-filter:blur(${pt(30)}) saturate(1.8);box-shadow:0 ${pt(10)} ${pt(32)} rgb(0 0 0/0.32),0 0 0 var(--hair) rgb(0 0 0/0.18),inset 0 0 0 var(--hair) rgb(255 255 255/0.6);color:rgb(0 0 0/0.86);font-size:${pt(13)}`}
  >
    {items.map((item, i) => (
      <div style={`display:flex;align-items:center;gap:${pt(24)};height:${pt(22)};padding:0 ${pt(10)};border-radius:${pt(7)};white-space:nowrap;${i === 0 ? 'background:#0A84FF;color:#fff;' : ''}`}>
        <span style="flex:1">{item.label}</span>
        {item.key && <span style={`color:${i === 0 ? 'rgb(255 255 255/0.85)' : 'rgb(0 0 0/0.42)'}`}>{item.key}</span>}
      </div>
    ))}
  </div>
</Canvas>
