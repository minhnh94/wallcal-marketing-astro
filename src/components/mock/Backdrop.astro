---
// The capture backdrop from the capture skill's bgwin.swift, drawn on a 2560×1440pt screen: a plum-to-midnight
// gradient, soft glows and light ribbons.
// CoreGraphics draws y-up; here y runs down, so every y is flipped.
import { uid } from '../../lib/mock';
interface Props {
  /** The part of the screen behind the stage: x, y, width, height in points. */
  region: [number, number, number, number];
}
const { region } = Astro.props;
const W = 2560, H = 1440;
const id = uid('mkb');
const hex = (c: number) => `#${c.toString(16).padStart(6, '0')}`;
const glows: [number, number, number, number, number][] = [
  [0.12, 0.85, 0.55, 0xff8a4c, 0.62],
  [0.88, 0.88, 0.45, 0xff5e7e, 0.5],
  [0.8, 0.08, 0.6, 0x2fb8cf, 0.5],
  [0.1, 0.05, 0.55, 0x6c5ce7, 0.6],
  [0.5, 0.5, 0.35, 0xc76ba8, 0.22],
];
const ribbons = [[-0.35, 0.3, 1.3, 0.95], [-0.3, 0.05, 1.35, 0.8], [-0.25, -0.1, 1.4, 0.55]].map(([x0, y0, x1, y1]) =>
  `M${x0 * W} ${(1 - y0) * H}C${(x0 + 0.45) * W} ${(1 - y0) * H} ${(x1 - 0.45) * W} ${(1 - y1) * H} ${x1 * W} ${(1 - y1) * H}`);
---
<svg class="mk-backdrop" viewBox={region.join(' ')} preserveAspectRatio="none" aria-hidden="true">
  <defs>
    <linearGradient id={`${id}-base`} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2={W} y2={H}>
      <stop offset="0" stop-color="#2A1638" />
      <stop offset="0.55" stop-color="#1B1A3F" />
      <stop offset="1" stop-color="#0F2A44" />
    </linearGradient>
    {glows.map(([x, y, r, c, a], i) => (
      <radialGradient id={`${id}-g${i}`} gradientUnits="userSpaceOnUse" cx={x * W} cy={(1 - y) * H} r={r * Math.max(W, H)}>
        <stop offset="0" stop-color={hex(c)} stop-opacity={a} />
        <stop offset="1" stop-color={hex(c)} stop-opacity="0" />
      </radialGradient>
    ))}
  </defs>
  <rect x={-W} y={-H} width={3 * W} height={3 * H} fill={`url(#${id}-base)`} />
  {glows.map((_, i) => <rect x={-W} y={-H} width={3 * W} height={3 * H} fill={`url(#${id}-g${i})`} />)}
  {ribbons.map((d, i) => (
    <g fill="none">
      <path d={d} stroke="#fff" stroke-opacity="0.1" stroke-width={60 + i * 30} />
      <path d={d} stroke="#FFE7D6" stroke-opacity="0.55" stroke-width="3" />
    </g>
  ))}
</svg>
