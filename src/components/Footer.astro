---
import Logo from './Logo.astro';
import { links } from '../lib/links';
import { useLocalizePath, useTranslations } from '../i18n';
import en from '../i18n/en';

const t = useTranslations(Astro.url);
const l = useLocalizePath(Astro.url);

// `track` stays English so analytics labels don't split by language.
const page = (key: 'home' | 'features' | 'addon' | 'faq' | 'contact' | 'ack', href: string) => ({
  label: t.footer[key],
  track: en.footer[key],
  href: l(href),
});

const columns = [
  {
    title: t.footer.product,
    items: [
      page('home', '/'),
      page('features', '/#features'),
      page('addon', '/expert-calendar-addon'),
      page('faq', '/#faq'),
    ],
  },
  {
    title: t.footer.download,
    items: [
      { label: 'Mac App Store', track: 'Mac App Store', href: links.appStore, provider: 'app_store', external: true },
      { label: 'Setapp', track: 'Setapp', href: links.setapp, provider: 'setapp', external: true },
    ],
  },
  {
    title: t.footer.company,
    items: [
      page('contact', '/support'),
      page('ack', '/acknowledgements'),
    ],
  },
];
---

<footer class="relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr] py-14 border-t border-black/[0.07]">

      <div class="space-y-4">
        <Logo />
        <p class="text-sm text-ink-500 max-w-xs">
          {t.footer.tagline}
        </p>
        <p class="text-sm text-ink-500">
          {t.footer.contactPrefix} <a class="text-ink-950 hover:underline" href="mailto:tsukie.studio@gmail.com" data-posthog-event="support_email_clicked" data-posthog-location="footer" data-posthog-email="support@wallcal.app">support@wallcal.app</a>
        </p>
        <a
          class="inline-flex items-center gap-2 text-sm text-ink-700 hover:text-ink-950 transition"
          href={links.twitter}
          target="_blank"
          rel="nofollow noreferrer"
          aria-label={t.footer.followX}
          data-posthog-event="social_link_clicked"
          data-posthog-location="footer"
          data-posthog-network="twitter"
        >
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-ink-950 text-white">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="m13.063 9 3.495 4.475L20.601 9h2.454l-5.359 5.931L24 23h-4.938l-3.866-4.893L10.771 23H8.316l5.735-6.342L8 9h5.063Zm-.74 1.347h-1.457l8.875 11.232h1.36l-8.778-11.232Z"></path>
            </svg>
          </span>
          @WallCalApp
        </a>
      </div>

      {columns.map((col) => (
        <div>
          <h3 class="text-sm font-semibold text-ink-950 mb-4">{col.title}</h3>
          <ul class="space-y-2.5 text-sm">
            {col.items.map((item) => (
              <li>
                {'provider' in item ? (
                  <a
                    class="text-ink-500 hover:text-ink-950 transition"
                    href={item.href}
                    target="_blank"
                    rel="nofollow noreferrer"
                    data-posthog-event="download_cta_clicked"
                    data-posthog-location="footer"
                    data-posthog-provider={item.provider}
                    data-posthog-cta-text={item.track}
                  >{item.label}</a>
                ) : (
                  <a
                    class="text-ink-500 hover:text-ink-950 transition"
                    href={item.href}
                    data-posthog-event="navigation_link_clicked"
                    data-posthog-location="footer"
                    data-posthog-nav-label={item.track}
                  >{item.label}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-2 pb-10 text-xs text-ink-500">
      <span>&copy; tsukie</span>
      <span>{t.footer.madeFor}</span>
    </div>
  </div>

  <!-- Oversized wordmark -->
  <div class="relative h-[18vw] max-h-56 w-full overflow-hidden pointer-events-none select-none" aria-hidden="true">
    <div class="absolute inset-x-0 top-0 text-center font-semibold leading-none tracking-[-0.06em] text-[24vw] bg-linear-to-b from-black/[0.08] to-transparent bg-clip-text text-transparent">
      WallCal
    </div>
  </div>
</footer>
