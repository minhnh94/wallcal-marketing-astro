---
interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;
---
<a class="inline-flex items-center gap-2" href="/" aria-label="WallCal">
  <img src="/my-assets/app-icon.png" alt="" width="28" height="28" />
  <span class:list={['text-[17px] font-semibold tracking-tight', dark ? 'text-white' : 'text-ink-950']}>WallCal</span>
</a>
