---
interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
---

<div
  x-data="{ expanded: false }"
  class="rounded-3xl bg-white ring-1 ring-black/[0.06] transition-shadow"
  :class="expanded && 'shadow-[0_12px_40px_-24px_rgba(0,0,0,0.25)]'"
>
  <h3>
    <button
      class="flex items-center justify-between w-full text-left font-medium text-[17px] px-6 py-5"
      data-posthog-event="faq_item_toggled"
      data-posthog-question={question}
      @click="expanded = !expanded"
      :aria-expanded="expanded"
    >
      <span>{question}</span>
      <span class="flex items-center justify-center w-8 h-8 rounded-full bg-paper shrink-0 ml-6">
        <svg
          class="w-3.5 h-3.5 text-ink-700 transition-transform duration-300"
          :class="expanded && 'rotate-45'"
          viewBox="0 0 14 14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M7 1v12M1 7h12" />
        </svg>
      </span>
    </button>
  </h3>
  <div
    class="grid text-ink-500 overflow-hidden transition-all duration-300 ease-in-out"
    :class="expanded ? 'grid-rows-[1fr] opacity-100' : 'grid-rows-[0fr] opacity-0'"
  >
    <div class="overflow-hidden">
      <p class="px-6 pb-5 whitespace-pre-line">{answer}</p>
    </div>
  </div>
</div>
