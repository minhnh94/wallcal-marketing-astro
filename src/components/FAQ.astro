---
import FAQItemComponent from './FAQItem.astro';
import { links } from '../lib/links';
import { faq } from '../data/faq';
import { getLocale, useTranslations } from '../i18n';

const locale = getLocale(Astro.url);
const t = useTranslations(Astro.url).faq;
const items = faq.map((entry) => ({ id: entry.id, ...entry[locale] }));
// The app's menu bar links to wallcal.app#faq; keep the section id.
---

<section id="faq" class="pt-24 md:pt-36 scroll-mt-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid lg:grid-cols-[1fr_1.6fr] gap-10 lg:gap-16">
      <div data-aos="fade-up">
        <span class="eyebrow">{t.eyebrow}</span>
        <h2 class="mt-4 text-h2 font-semibold">{t.title}</h2>
        <p class="mt-4 text-ink-500">
          {t.leadBefore}
          <a
            class="text-ink-950 underline decoration-black/20 underline-offset-4 hover:decoration-black/60"
            href={`mailto:${links.supportEmail}`}
            data-posthog-event="support_email_clicked"
            data-posthog-location="faq"
            data-posthog-email={links.supportEmail}
          >{links.supportEmail}</a>{t.leadAfter}
        </p>
      </div>
      <div class="space-y-3" data-aos="fade-up" data-aos-delay="100">
        {items.map((item) => (
          <FAQItemComponent id={item.id} question={item.question} answer={item.answer} />
        ))}
      </div>
    </div>
  </div>
</section>
