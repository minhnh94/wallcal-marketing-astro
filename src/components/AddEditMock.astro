---
// A drawn stand-in for WallCal's add-and-edit panel: a few month cells, the dashed placeholder of the item
// being added, and the speech-bubble panel pointing at it. Decorative; the card's text says what it shows.
import type { Dict } from '../i18n/en';

interface Props {
  m: Dict['features']['edit']['mock'];
  class?: string;
}
const { m, class: className } = Astro.props;
const days = [16, 17, 18, 19, 20, 21, 22, 23];
---
<div class:list={['relative rounded-2xl bg-ink-950 p-4 md:p-5 overflow-hidden text-white select-none', className]} aria-hidden="true">
  <div class="flex justify-end">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/20 ring-1 ring-emerald-400/40 text-emerald-300 px-2.5 py-1 text-[11px] font-medium">
      <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2.5H3.5a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1V8"/><path d="m11.5 2 2.5 2.5L8 10.5H5.5V8z"/></svg>
      {m.switchOn}
    </span>
  </div>

  <div class="mt-3 grid grid-cols-4 gap-px rounded-xl overflow-hidden bg-white/10 sm:w-[64%]">
    {days.map((day) => (
      <div class="bg-ink-950 h-20 md:h-24 p-1.5 flex flex-col gap-1">
        <span class:list={['self-end text-[11px] font-medium', day === 18 ? 'flex items-center justify-center w-5 h-5 rounded-full bg-red-500' : 'text-white/80']}>{day}</span>
        {day === 17 && (
          <span class="flex items-center gap-1 rounded bg-sky-400/10 px-1 py-0.5 text-[9px] truncate"><span class="w-0.5 self-stretch rounded bg-sky-400"></span>{m.standup}</span>
        )}
        {day === 22 && (
          <span class="flex items-center gap-1 rounded bg-amber-400/10 px-1 py-0.5 text-[9px] truncate"><span class="w-0.5 self-stretch rounded bg-amber-400"></span>{m.gym}</span>
        )}
        {day === 19 && (
          <span class="rounded border border-dashed border-orange-400 bg-orange-400/20 px-1 py-0.5 text-[9px] font-semibold truncate">{m.title}</span>
        )}
      </div>
    ))}
  </div>

  <!-- The panel, its point aimed at the placeholder; below the grid, without a point, on narrow screens -->
  <div class="relative mt-3 sm:mt-0 sm:absolute sm:left-[calc(64%+1.75rem)] sm:right-4 sm:top-[4rem] md:top-[4.25rem] rounded-2xl bg-[#2a2a31] ring-1 ring-white/15 shadow-2xl shadow-black/60 p-3 text-[11px]">
    <span class="hidden sm:block absolute -left-[7px] top-5 w-3.5 h-3.5 rotate-45 bg-[#2a2a31] border-l border-b border-white/15"></span>
    <div class="relative">
      <div class="inline-flex rounded-md bg-white/10 p-0.5 text-[10px]">
        <span class="rounded px-2 py-0.5 bg-white/25">{m.event}</span>
        <span class="px-2 py-0.5 text-white/70">{m.todo}</span>
      </div>
      <p class="mt-2 text-[14px] font-semibold truncate">{m.title}</p>
      <div class="mt-2 flex items-center gap-2 text-white/80">
        <span class="text-white/50">{m.starts}</span>
        <span class="rounded bg-white/10 px-1.5 py-0.5 tabular-nums">{m.when}</span>
      </div>
      <div class="mt-3 pt-2 border-t border-white/10 flex items-center justify-between gap-2">
        <span class="flex items-center gap-1.5 text-white/80 truncate"><span class="w-2 h-2 rounded-full bg-orange-400 shrink-0"></span>{m.calendar}</span>
        <span class="rounded-md bg-sky-500 px-2.5 py-1 font-medium">{m.add}</span>
      </div>
    </div>
  </div>
</div>
