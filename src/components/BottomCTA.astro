---
import { links } from '../lib/links';
---

<section class="pt-24 md:pt-32 pb-20 md:pb-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="wallpaper relative overflow-hidden rounded-[32px] px-6 py-16 md:py-24 text-center" data-aos="fade-up">
      <div class="glass relative mx-auto max-w-2xl rounded-[28px] px-6 py-12 md:px-12">
        <img src="/my-assets/app-icon.png" alt="" width="72" height="72" class="mx-auto drop-shadow-lg" />
        <h2 class="mt-6 text-h2 font-semibold text-balance">
          Give your desktop
          <span class="font-serif italic font-normal">something to do.</span>
        </h2>
        <p class="mt-4 text-lg text-ink-700">Free on the Mac App Store. Built for macOS Tahoe.</p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            class="btn btn-primary w-full sm:w-auto"
            data-posthog-event="download_cta_clicked"
            data-posthog-location="bottom_cta"
            data-posthog-provider="app_store"
            data-posthog-cta-text="Download now"
            href={links.appStore}
            target="_blank"
            rel="nofollow noreferrer"
          >
            Download now <span aria-hidden="true">&rarr;</span>
          </a>
          <a
            class="btn btn-glass w-full sm:w-auto"
            data-posthog-event="download_cta_clicked"
            data-posthog-location="bottom_cta"
            data-posthog-provider="setapp"
            data-posthog-cta-text="Setapp"
            href={links.setapp}
            target="_blank"
            rel="nofollow noreferrer"
          >
            Get it on Setapp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
