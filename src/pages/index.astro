---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ValueProps from '../components/home/ValueProps.astro';
import FeatureBento from '../components/home/FeatureBento.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import ExpertAddon from '../components/home/ExpertAddon.astro';
import GetWallCal from '../components/home/GetWallCal.astro';
import FAQ from '../components/FAQ.astro';
import BottomCTA from '../components/BottomCTA.astro';
import { getFAQItems } from '../lib/notion';

const faqItems = await getFAQItems();
---
<BaseLayout title="WallCal – Your calendar, right on your Mac wallpaper">

  <Hero />
  <ValueProps />
  <FeatureBento />
  <HowItWorks />
  <ExpertAddon />

  <!-- Pricing + Setapp affiliate banner -->
  <GetWallCal />

  <FAQ items={faqItems} />

  <!-- Discussion -->
  <section class="pt-16 md:pt-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl mx-auto">
        <script async src="https://yappie.tsukie.com/embed/bfbb7df1-d2fe-46a2-8db7-fdcf2978e848.js"></script>
      </div>
    </div>
  </section>

  <BottomCTA />

</BaseLayout>
