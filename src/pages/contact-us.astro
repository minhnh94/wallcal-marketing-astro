---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<BaseLayout title="Contact Us — WallCal" description="Questions about WallCal or WallCal Lite? Email support@wallcal.app and we’ll help.">
  <section class="relative isolate pt-36 pb-20 md:pt-44 md:pb-28">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <PageHeader
        eyebrow="Support"
        title="Contact Us"
        lead="If you purchased our macOS app WallCal/WallCal Lite and you encountered any troubles, or need support regarding a specific function, please don't hesitate to email us."
      />
      <div class="mt-12 card p-8 md:p-10 text-center" data-aos="fade-up" data-aos-delay="200">
        <h2 class="text-sm font-medium uppercase tracking-[0.14em] text-ink-500">Email support</h2>
        <a
          class="mt-3 inline-block text-2xl md:text-3xl font-semibold tracking-tight text-ink-950 hover:text-brand-500 transition"
          href="mailto:support@wallcal.app"
          data-posthog-event="support_email_clicked"
          data-posthog-location="contact_page"
          data-posthog-email="support@wallcal.app"
        >
          support@wallcal.app
        </a>
        <div class="mt-6">
          <a class="btn btn-primary" href="mailto:support@wallcal.app" data-posthog-event="support_email_clicked" data-posthog-location="contact_page_button" data-posthog-email="support@wallcal.app">Write to us</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
