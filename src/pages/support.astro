---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.url);
---
<BaseLayout title={t.meta.contactTitle} description={t.meta.contactDescription}>
  <section class="relative isolate pt-36 pb-20 md:pt-44 md:pb-28">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <PageHeader
        eyebrow={t.contact.eyebrow}
        title={t.contact.title}
        lead={t.contact.lead}
      />
      <div class="mt-12" data-aos="fade-up" data-aos-delay="100">
        <script async src="https://yappie.tsukie.com/embed/bfbb7df1-d2fe-46a2-8db7-fdcf2978e848.js"></script>
      </div>
      <div class="mt-12 card p-8 md:p-10 text-center" data-aos="fade-up" data-aos-delay="200">
        <h2 class="text-sm font-medium uppercase tracking-[0.14em] text-ink-500">{t.contact.emailLabel}</h2>
        <a
          class="mt-3 inline-block text-2xl md:text-3xl font-semibold tracking-tight text-ink-950 hover:text-brand-500 transition"
          href="mailto:support@wallcal.app"
          data-posthog-event="support_email_clicked"
          data-posthog-location="contact_page"
          data-posthog-email="support@wallcal.app"
        >
          support@wallcal.app
        </a>
        <div class="mt-6">
          <a class="btn btn-primary" href="mailto:support@wallcal.app" data-posthog-event="support_email_clicked" data-posthog-location="contact_page_button" data-posthog-email="support@wallcal.app">{t.contact.button}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
