---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { useLinks } from '../lib/links';
import { useTranslations } from '../i18n';

const links = useLinks(Astro.url);

const t = useTranslations(Astro.url);
const p = t.addonPage;

// Each clip is a real WallCal capture switching between the setting's values.
const clips = ['weekly-agenda', 'time-range', 'days-to-show', 'calendar-filtering', 'view-toggle', 'time-format', 'week-start'] as const;
const features = clips.map((clip) => ({ clip, ...p.features[clip] }));
---
<BaseLayout title={t.meta.addonTitle} description={t.meta.addonDescription}>
  <section class="relative isolate pt-36 pb-12 md:pt-44 md:pb-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <PageHeader
        eyebrow={p.eyebrow}
        title={p.title}
        lead={p.lead}
      />

      <div class="mt-14 grid md:grid-cols-2 gap-4">
        {features.map((feature, i) => (
          <article class:list={['card overflow-hidden', i === 0 && 'md:col-span-2']} data-aos="fade-up" data-aos-delay={(i % 2) * 100}>
            <div class="p-2 pb-0">
              <video
                class="w-full aspect-video rounded-[22px] bg-ink-900 object-cover"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster={`/my-assets/addon/${feature.clip}-poster.jpg`}
                aria-label={p.clipLabel(feature.title)}
                data-addon-clip
              >
                <source src={`/my-assets/addon/${feature.clip}.mp4`} type="video/mp4" />
                <source src={`/my-assets/addon/${feature.clip}.webm`} type="video/webm" />
              </video>
            </div>
            <div class="p-6 md:p-7">
              <span class="text-xs font-medium text-brand-500">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="mt-1 text-xl font-semibold tracking-tight">{feature.title}</h2>
              <p class="mt-1.5 text-ink-500">{feature.description}</p>
            </div>
          </article>
        ))}
      </div>

      <script is:inline>
        (() => {
          // Respect reduced motion: show posters instead of looping clips.
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          document.querySelectorAll('[data-addon-clip]').forEach((v) => {
            v.removeAttribute('autoplay');
            v.pause();
          });
        })();
      </script>

      <div class="mt-14 text-center" data-aos="fade-up">
        <p class="text-ink-500">{p.footnote}</p>
        <div class="mt-5 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            class="btn btn-primary w-full sm:w-auto"
            href={links.appStore}
            target="_blank"
            rel="nofollow noreferrer"
            data-posthog-event="download_cta_clicked"
            data-posthog-location="addon_page"
            data-posthog-provider="app_store"
            data-posthog-cta-text="App Store"
          >{p.ctaAppStore}</a>
          <a
            class="btn btn-glass w-full sm:w-auto"
            href={links.setapp}
            target="_blank"
            rel="nofollow noreferrer"
            data-posthog-event="download_cta_clicked"
            data-posthog-location="addon_page"
            data-posthog-provider="setapp"
            data-posthog-cta-text="Setapp"
          >{p.ctaSetapp}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
