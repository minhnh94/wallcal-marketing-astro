---
import '../styles/global.css';
import 'aos/dist/aos.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostHog from '../components/posthog.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'See your week at a glance, right on your Mac desktop. Calendars and reminders behind every window, in native Liquid Glass. Free on the Mac App Store.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/my-assets/og.jpg', Astro.site).href;
const ogImageAlt = 'WallCal month view on a Mac desktop, next to the headline "Your calendar, right on your wallpaper."';
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#f7f6f3" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="WallCal" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@WallCalApp" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />
  <PostHog />
</head>
<body class="font-sans antialiased bg-paper text-ink-950">
  <div class="flex flex-col min-h-screen overflow-hidden supports-[overflow:clip]:overflow-clip">
    <Header />
    <main class="grow">
      <slot />
    </main>
    <Footer />
  </div>
  <!-- AOS init -->
  <script>
    import AOS from 'aos';
    AOS.init({
      once: true,
      disable: 'phone',
      duration: 700,
      easing: 'ease-out-cubic',
    });
  </script>
</body>
</html>
