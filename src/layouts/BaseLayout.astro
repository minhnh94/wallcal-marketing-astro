---
import '../styles/global.css';
import 'aos/dist/aos.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostHog from '../components/posthog.astro';
import { getLocale, localeMeta, locales, localizePath, prefixedLocales, stripLocale, useTranslations } from '../i18n';

interface Props {
  title: string;
  description?: string;
}

const locale = getLocale(Astro.url);
const t = useTranslations(Astro.url);
const { title, description = t.meta.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const basePath = stripLocale(Astro.url.pathname);
const alternates = locales.map((l) => ({
  hreflang: localeMeta[l].htmlLang,
  href: new URL(localizePath(basePath, l), Astro.site).href,
}));
const ogImage = new URL(locale === 'en' ? '/my-assets/og.jpg' : `/my-assets/og-${locale}.jpg`, Astro.site).href;
const ogImageAlt = t.meta.ogImageAlt;
---
<!DOCTYPE html>
<html lang={localeMeta[locale].htmlLang} class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
  {locale === 'en' && (
    <script is:inline define:vars={{ supported: prefixedLocales }}>
      // English pages only: send first-time visitors to their browser language if we have it.
      // An explicit pick in the language switcher is remembered and always wins.
      try {
        var saved = localStorage.getItem('wallcal-locale');
        if (!saved && !/bot|crawl|spider|slurp|preview/i.test(navigator.userAgent)) {
          var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
          for (var i = 0; i < langs.length; i++) {
            var code = String(langs[i]).toLowerCase().split('-')[0];
            if (code === 'en') break;
            if (supported.indexOf(code) !== -1) {
              location.replace('/' + code + location.pathname + location.search + location.hash);
              break;
            }
          }
        }
      } catch (e) {}
    </script>
  )}
  <script is:inline>
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[data-posthog-event="language_switched"]');
      if (a) try { localStorage.setItem('wallcal-locale', a.getAttribute('data-posthog-to')); } catch (err) {}
    });
  </script>
  <meta name="theme-color" content="#f7f6f3" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="WallCal" />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={localeMeta[locale].ogLocale} />
  {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@WallCalApp" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />
  <PostHog />
</head>
<body class="font-sans antialiased bg-paper text-ink-950">
  <div class="flex flex-col min-h-screen overflow-hidden supports-[overflow:clip]:overflow-clip">
    <Header />
    <main class="grow">
      <slot />
    </main>
    <Footer />
  </div>
  <!-- AOS init -->
  <script>
    import AOS from 'aos';
    AOS.init({
      once: true,
      disable: 'phone',
      duration: 700,
      easing: 'ease-out-cubic',
    });
  </script>
</body>
</html>
